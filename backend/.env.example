APP_ENV=development
DATABASE_URL=sqlite:///./data/procurement.db
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_FOR_LOCAL_OR_DEPLOYMENT
TOKEN_MINUTES=30
REFRESH_DAYS=7
CORS_ORIGINS=https://www.procumaterial.com,https://procumaterial.com,http://localhost:3000
REDIS_URL=
MOCK_NOTIFICATIONS=true
# Attempts newly requested authentication deliveries after the API response.
AUTH_DELIVERY_AUTO_DISPATCH=true
SMS_PROVIDER=android_gateway
SMS_GATEWAY_ENABLED=false
SMS_GATEWAY_MODE=mock
SMS_GATE_API_URL=https://api.sms-gate.app/3rdparty/v1/messages
SMS_GATE_USERNAME=
SMS_GATE_PASSWORD=
# Spaceship Spacemail SMTP configuration
SMTP_HOST=mail.spacemail.com
SMTP_PORT=465
SMTP_SECURITY=SSL/TLS
SMTP_USERNAME=your-email@procumaterial.com
SMTP_PASSWORD=your-mailbox-password
SMTP_FROM_EMAIL=your-email@procumaterial.com
SMTP_FROM_NAME=Procumaterial
SMTP_REPLY_TO=
SMTP_USE_TLS=true

# Aiven project CA downloaded from your service Overview. Relative to backend/.
# Keep TLS verification enabled; the API and notification worker use this file.
DATABASE_SSLROOTCERT=
FIELD_ENCRYPTION_KEY=
DELIVERY_TIMEOUT_SECONDS=10
DELIVERY_MAX_ATTEMPTS=5
DELIVERY_STATUS_MAX_POLLS=24
UPLOAD_DIR=./data/private
MAX_UPLOAD_BYTES=5000000
MATCHING_BATCH_SIZE=5

# Bound database waits; restart API/workers after changes.
DATABASE_CONNECT_TIMEOUT=5
DATABASE_LOCK_TIMEOUT_MS=3000
DATABASE_STATEMENT_TIMEOUT_MS=15000

# Explicit controlled-live-test recipients; never inferred from supplier contacts.
NOTIFICATION_TEST_PHONE=
NOTIFICATION_TEST_EMAIL=
# python scripts/live_test.py prepares only; --approved is required to send.

# RFQ participation: self-declared categories by default; company verification still required.
REQUIRE_CAPABILITY_APPROVAL=false

# Cloudflare R2 (leave disabled for local development without R2 credentials)
R2_ENABLED=false
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_REGION=auto
R2_PUBLIC_BUCKET=procumaterial-public
R2_PRIVATE_BUCKET=procumaterial-private
R2_PUBLIC_BASE_URL=https://assets.procumaterial.com
R2_PRESIGNED_UPLOAD_TTL=300
R2_PRESIGNED_DOWNLOAD_TTL=300
R2_MAX_IMAGE_BYTES=10485760
R2_MAX_DOCUMENT_BYTES=26214400
R2_ALLOWED_ORIGINS=http://localhost:3000,https://procumaterial.com,https://www.procumaterial.com

# Absolute frontend origin used in authenticated notification links.
FRONTEND_URL=http://localhost:3000
