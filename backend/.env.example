APP_ENV=development
# Disable API-embedded polling when using the dedicated import worker service.
EMBEDDED_IMPORT_WORKER_ENABLED=true
DATABASE_URL=sqlite:///./data/procurement.db
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_FOR_LOCAL_OR_DEPLOYMENT
TOKEN_MINUTES=30
REFRESH_DAYS=7
CORS_ORIGINS=https://www.procumaterial.com,https://procumaterial.com,http://localhost:3000
REDIS_URL=
MOCK_NOTIFICATIONS=true
# Attempts newly requested authentication deliveries after the API response.
AUTH_DELIVERY_AUTO_DISPATCH=true
SMS_PROVIDER=android_gateway
SMS_GATEWAY_ENABLED=false
SMS_GATEWAY_MODE=mock
SMS_GATE_API_URL=https://api.sms-gate.app/3rdparty/v1/messages
SMS_GATE_USERNAME=
SMS_GATE_PASSWORD=
# Spaceship Spacemail SMTP configuration
SMTP_HOST=mail.spacemail.com
SMTP_PORT=465
SMTP_SECURITY=SSL/TLS
SMTP_USERNAME=your-email@procumaterial.com
SMTP_PASSWORD=your-mailbox-password
SMTP_FROM_EMAIL=your-email@procumaterial.com
SMTP_FROM_NAME=Procumaterial
SMTP_REPLY_TO=
SMTP_USE_TLS=true
# Optional envelope sender (Return-Path) so bounces go to a dedicated mailbox instead of
# the business inbox. Leave empty unless the SMTP account is allowed to use it.
SMTP_ENVELOPE_FROM=
# Provider sending limits shared by all workers (0 = unlimited). Set to the provider's
# documented limits; Spacemail mailboxes are not a bulk/transactional sending service.
EMAIL_SEND_LIMIT_PER_MINUTE=20
EMAIL_SEND_LIMIT_PER_HOUR=250
SMS_SEND_LIMIT_PER_MINUTE=10
OUTBOX_BATCH_SIZE=25
OUTBOX_ORG_BATCH_SHARE=10
EMAIL_SOFT_BOUNCE_MAX_RETRIES=3
EMAIL_SOFT_BOUNCE_BASE_DELAY_SECONDS=1800
# Signed provider delivery/bounce webhook (POST /api/v1/notifications/webhooks/email).
EMAIL_WEBHOOK_SECRET=
# Dedicated return-path mailbox for app.bounce_worker (IMAPS). Empty host disables it.
BOUNCE_IMAP_HOST=
BOUNCE_IMAP_PORT=993
BOUNCE_IMAP_USERNAME=
BOUNCE_IMAP_PASSWORD=
BOUNCE_IMAP_FOLDER=INBOX
BOUNCE_IMAP_PROCESSED_FOLDER=Processed-Bounces
# Supplier invitation portal: restricted session lifetime and verification code expiry.
SUPPLIER_PORTAL_SESSION_HOURS=8
SUPPLIER_PORTAL_CODE_MINUTES=15

# Aiven project CA downloaded from your service Overview. Relative to backend/.
# Keep TLS verification enabled; the API and notification worker use this file.
DATABASE_SSLROOTCERT=
FIELD_ENCRYPTION_KEY=
DELIVERY_TIMEOUT_SECONDS=10
DELIVERY_MAX_ATTEMPTS=5
DELIVERY_STATUS_MAX_POLLS=24
UPLOAD_DIR=./data/private
MAX_UPLOAD_BYTES=5000000
MATCHING_BATCH_SIZE=100
MATCHING_PUBLISH_TIME_BUDGET_SECONDS=2.5

# Bound database waits; restart API/workers after changes.
DATABASE_CONNECT_TIMEOUT=5
DATABASE_LOCK_TIMEOUT_MS=3000
DATABASE_STATEMENT_TIMEOUT_MS=15000

# Explicit controlled-live-test recipients; never inferred from supplier contacts.
NOTIFICATION_TEST_PHONE=
NOTIFICATION_TEST_EMAIL=
# python scripts/live_test.py prepares only; --approved is required to send.

# RFQ participation: self-declared categories by default; company verification still required.
REQUIRE_CAPABILITY_APPROVAL=false

# Cloudflare R2 (leave disabled for local development without R2 credentials)
R2_ENABLED=false
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_REGION=auto
R2_PUBLIC_BUCKET=procumaterial-public
R2_PRIVATE_BUCKET=procumaterial-private
R2_PUBLIC_BASE_URL=https://assets.procumaterial.com
R2_PRESIGNED_UPLOAD_TTL=300
R2_PRESIGNED_DOWNLOAD_TTL=300
R2_MAX_IMAGE_BYTES=10485760
R2_MAX_DOCUMENT_BYTES=26214400
R2_ALLOWED_ORIGINS=http://localhost:3000,https://procumaterial.com,https://www.procumaterial.com

# Absolute frontend origin used in authenticated notification links.
FRONTEND_URL=http://localhost:3000
# Shared cookie domain for cross-subdomain browser sessions (e.g. .procumaterial.com in production).
# Leave empty in local development; in production, derived from FRONTEND_URL if omitted.
COOKIE_DOMAIN=

# Trusted reverse-proxy chain for rate limiting (Nginx loopback + optional Cloudflare)
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
TRUST_CLOUDFLARE_PROXY=false
CLOUDFLARE_PROXY_CIDRS=

# Optional buyer RFQ material reranking; server-only. Empty key uses database matching.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_ENABLED=true
GEMINI_TIMEOUT_SECONDS=10
GEMINI_MAX_RETRIES=2
MATERIAL_MATCH_HIGH_THRESHOLD=90
MATERIAL_MATCH_MEDIUM_THRESHOLD=65
SUPPLIER_IMPORT_BATCH_SIZE=10
SUPPLIER_IMPORT_MAX_ROWS=100000
SUPPLIER_IMPORT_MAX_BYTES=25000000
