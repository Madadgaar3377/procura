# Browser requests go directly to FastAPI. Include /api/v1; keep localhost/127.0.0.1 consistent.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Legacy compatibility proxy upstream. Never put SMS/SMTP credentials here.
FASTAPI_INTERNAL_URL=http://127.0.0.1:8000
# BACKEND_URL remains supported for existing local setups.
NEXT_PUBLIC_DEMO_MODE=false
# Set the actual public origin to enable canonical URLs, hreflang and sitemap URLs.
# Leave unset until a real domain/origin has been chosen; no domain is invented.
# NEXT_PUBLIC_SITE_URL=
# Optional canonical browser origin behind a reverse proxy (scheme + hostname + port).
# FRONTEND_ORIGIN=http://localhost:3000
